# Optional: HTTP port (defaults to 3000).
PORT=3000

# Optional: bootstrap Google AI API key for the server at startup.
# Prefer entering the key in Settings -> AI Configuration instead of editing source or env files.
# GEMINI_API_KEY=your_google_ai_key_here

# Optional: directory for the server-encrypted AI configuration.
# Defaults to ~/.studyos. Keep this directory private and persistent.
STUDYOS_DATA_DIR=/path/to/private/studyos-data
